# Host IP used to build the service URLs below. Leave empty for localhost.
# For the OpenTOSCA ecosystem, set it to the IP of your machine (not localhost).
VITE_HOST_IP=

# Service endpoints
VITE_LOW_CODE_BACKEND=http://${VITE_HOST_IP:-localhost}:8000
VITE_NISQ_ANALYZER=http://${VITE_HOST_IP:-localhost}:8098/nisq-analyzer
VITE_QUNICORN=http://${VITE_HOST_IP:-localhost}:8080
VITE_PATTERN_ATLAS_UI=http://${VITE_HOST_IP:-localhost}:1978
VITE_PATTERN_ATLAS_API=http://${VITE_HOST_IP:-localhost}:1977/patternatlas/patternLanguages/af7780d5-1f97-4536-8da7-4194b093ab1d
VITE_QC_ATLAS=http://${VITE_HOST_IP:-localhost}:6626
VITE_CAMUNDA7_ENDPOINT=http://${VITE_HOST_IP:-localhost}:8090/engine-rest
VITE_WINERY_ENDPOINT=http://${VITE_HOST_IP:-localhost}:8093/winery
VITE_OPENTOSCA_ENDPOINT=http://${VITE_HOST_IP:-localhost}:1337/csars

# GitHub repository for "Upload to GitHub" (optional)
VITE_GITHUB_REPO_OWNER=
VITE_GITHUB_REPO_NAME=
VITE_GITHUB_REPO_BRANCH=
VITE_GITHUB_TOKEN=

# AI model generation (optional)
VITE_OPENAI_TOKEN=
VITE_MISTRAL_TOKEN=
MISTRAL_TOKEN=

# Domain profiles repository (raw base URL)
VITE_DOMAIN_PROFILES_URL=https://raw.githubusercontent.com/LEQO-Framework/domain-profiles/main
VITE_ENABLE_NODE_TESTING=true

# Model generation backend
DATABASE_URL=postgresql://app:app@localhost:5433/app
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_HOST=redis

# Host IP used by the OpenTOSCA ecosystem (docker-compose)
PUBLIC_HOSTNAME=
